{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "intentgate hook claude-code post",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "intentgate hook claude-code post",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "intentgate hook claude-code pre",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "intentgate hook claude-code pre",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "plan"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentgate.dev/schema/intentgate.lock.v1.json",
  "title": "IntentGate intent lock",
  "description": "The committed intent lock, schema intentgate.lock/1. The Go validation in internal/lock is the enforcement; this schema is the public contract. It has no field for root intent text and rejects unknown keys. JSON Schema cannot express every rule: duplicate criterion ids, glob syntax and calendar validity of ratified_at (for example February 30) are rejected by the Go validator, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "revision", "base_ref", "root_intent", "criteria", "ratification"],
  "properties": {
    "schema": { "const": "intentgate.lock/1" },
    "id": {
      "description": "ULID, stable across amendments.",
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "revision": { "type": "integer", "minimum": 1 },
    "base_ref": { "type": "string", "minLength": 1 },
    "root_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "source", "redactions"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source": { "enum": ["claude-code-session", "issue", "plan-file"] },
        "redactions": { "description": "Secrets masked in the root intent before it was hashed (REQ-0015).", "type": "integer", "minimum": 0 }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "footprint"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "pattern": "\\S" },
          "footprint": {
            "description": "Path globs; a leading ! excludes. Glob syntax is checked by the Go validation.",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "not": { "const": "!" } }
          }
        }
      }
    },
    "ratification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratifier", "ratified_at", "method", "review_duration_ms"],
      "properties": {
        "ratifier": { "type": "string", "pattern": "\\S" },
        "ratified_at": {
          "description": "RFC 3339, UTC (Z suffix).",
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
        },
        "method": { "enum": ["hook", "cli-confirm", "issue"] },
        "review_duration_ms": { "description": "Recorded, never judged.", "type": "integer", "minimum": 0 },
        "drafted_by": { "type": "string" }
      }
    },
    "plan_review": {
      "description": "The advisory plan review's outcome at ratification: the status and the three counts, never finding text (REQ-0014). Optional: locks made before the plan review have none. When present all four keys are required.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "omissions", "additions", "weakenings"],
      "properties": {
        "status": { "enum": ["complete", "partial", "unavailable", "error"] },
        "omissions": { "type": "integer", "minimum": 0 },
        "additions": { "type": "integer", "minimum": 0 },
        "weakenings": { "type": "integer", "minimum": 0 }
      }
    },
    "amendments": {
      "description": "One entry per revision after the first: revisions are 2, 3, … in order and the last equals the lock's revision (checked by the Go validation). An add-glob names a criterion and a glob that is in that criterion's footprint; a reratify names neither.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "kind", "by", "at", "method"],
        "properties": {
          "revision": { "type": "integer", "minimum": 2 },
          "kind": { "enum": ["add-glob", "reratify"] },
          "criterion": { "type": "string", "minLength": 1 },
          "glob": { "type": "string", "minLength": 1, "not": { "const": "!" } },
          "by": { "type": "string", "pattern": "\\S" },
          "at": {
            "description": "RFC 3339, UTC (Z suffix).",
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
          },
          "method": { "enum": ["hook", "cli-confirm", "issue"] }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "add-glob" } }, "required": ["kind"] },
            "then": { "required": ["criterion", "glob"] },
            "else": { "not": { "anyOf": [{ "required": ["criterion"] }, { "required": ["glob"] }] } }
          }
        ]
      }
    },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

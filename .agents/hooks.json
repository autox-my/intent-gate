{
  "intentgate": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "intentgate hook antigravity post-invocation",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "intentgate hook antigravity pre",
            "timeout": 60
          }
        ]
      }
    ],
    "enabled": true
  }
}
